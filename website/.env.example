# allin 官网 · 配置样例
# 用法：cp .env.example .env 后按需修改。.env 已被 .gitignore 忽略，**禁止提交**。
# 说明：所有项都有默认值，不建 .env 也能直接 npm start。

# —— 服务 ——
PORT=9042
SITE_BASE_URL=http://localhost:9042

# —— 会话 ——
SESSION_COOKIE_NAME=allin_sid
SESSION_TTL_HOURS=72
# 本地 http 部署保持 false；反向代理 HTTPS 后改为 true
COOKIE_SECURE=false

# —— 存储与密钥 ——
DB_PATH=./data/site.db
KEY_DIR=./data/keys
# 主密钥（KEK，base64 编码的 32 字节）。留空时由 scripts/init-db.js
# 在 KEY_DIR 下生成随机主密钥文件（权限 0600），生产环境建议改为注入环境变量。
SITE_MASTER_KEY_BASE64=

# —— 上传 ——
MAX_UPLOAD_MB=5
