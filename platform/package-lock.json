{
  "name": "allin-platform",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "allin-platform",
      "version": "0.1.0",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "apps/cli": {
      "name": "@allin/cli",
      "version": "0.1.0",
      "dependencies": {
        "@allin/core": "0.1.0"
      },
      "bin": {
        "allin": "src/index.js"
      },
      "engines": {
        "node": ">=22"
      }
    },
    "apps/portal": {
      "name": "@allin/portal",
      "version": "0.1.0",
      "dependencies": {
        "@allin/core": "0.1.0",
        "js-yaml": "^4.1.0"
      },
      "engines": {
        "node": ">=22"
      }
    },
    "node_modules/@allin/cli": {
      "resolved": "apps/cli",
      "link": true
    },
    "node_modules/@allin/core": {
      "resolved": "packages/core",
      "link": true
    },
    "node_modules/@allin/portal": {
      "resolved": "apps/portal",
      "link": true
    },
    "node_modules/argparse": {
      "version": "2.0.1",
      "resolved": "https://registry.npmmirror.com/argparse/-/argparse-2.0.1.tgz",
      "integrity": "sha512-8+9WqebbFzpX9OR+Wa6O29asIogeRMzcGtAINdpMHHyAg10f05aSFVBbcEqGf/PXw1EjAZ+q2/bEBg3DvurK3Q==",
      "license": "Python-2.0"
    },
    "node_modules/js-yaml": {
      "version": "4.3.1",
      "resolved": "https://registry.npmmirror.com/js-yaml/-/js-yaml-4.3.1.tgz",
      "integrity": "sha512-CY6crGq313MX8GkwvB7tzgp99vjQxY1++5y10/BKN/GUfHqWaOGQMNZkBvqSzsZKWk/ijwHlWzzkLulsGHhjWQ==",
      "funding": [
        {
          "type": "github",
          "url": "https://github.com/sponsors/puzrin"
        },
        {
          "type": "github",
          "url": "https://github.com/sponsors/nodeca"
        }
      ],
      "license": "MIT",
      "dependencies": {
        "argparse": "^2.0.1"
      },
      "bin": {
        "js-yaml": "bin/js-yaml.js"
      }
    },
    "packages/core": {
      "name": "@allin/core",
      "version": "0.1.0",
      "dependencies": {
        "js-yaml": "^4.1.0"
      }
    }
  }
}
