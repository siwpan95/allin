{
  "name": "allin",
  "version": "0.1.0",
  "private": true,
  "description": "工作区治理仓（公开，MIT）：文档枢纽 + 可执行门禁 + cordis 治理 preset（粘合剂）",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check": "npm run check:governance && npm run check:docs && npm run check:ps1",
    "check:governance": "node tools/gate/governance/run.ts --no-profile",
    "check:governance:selfcheck": "node tools/gate/governance/run.ts --selfcheck-all",
    "check:precommit": "node tools/gate/governance/run.ts --no-profile --only g01-paths,g03-credentials,g05-hygiene,g06-numbering,g07-doc-freshness,g08-deletion-evidence,g09-python-hygiene,g10-failloud-probe,g11-undef-names,g12-integrity,g13-docs-only,g14-preset,g15-docs-contract,g16-skill-preset-parity,g17-registry,g18-exceptions,g19-docs-refs",
    "check:docs": "python tools/gate/docs_index.py",
    "check:ps1": "python tools/gate/check_ps1_bom.py --root .",
    "verify:projects": "python tools/verify_projects.py --workers 8",
    "metrics:gates": "python tools/gate/gate_metrics.py --snapshot",
    "sbom": "python tools/sbom.py",
    "licenses": "python tools/license_matrix.py"
  }
}
