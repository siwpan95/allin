<%- include('partials/head') %>

<section class="section" style="padding-top:2.8rem">
  <div class="container">
    <div class="row" style="justify-content:space-between;align-items:flex-end">
      <div>
        <span class="eyebrow">// member console</span>
        <h1 style="font-size:2rem;margin-bottom:.3rem">你好，<%= user.displayName %></h1>
        <p class="muted" style="margin:0">这里是你的服务控制台：工单进度、交付文件与会话状态。</p>
      </div>
      <form method="post" action="/logout" style="margin:0">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn--sm btn--ghost" type="submit">安全登出</button>
      </form>
    </div>
  </div>
</section>

<section class="section--tight">
  <div class="container grid grid--2" style="align-items:start">
    <div class="panel">
      <div class="footer__title">当前会话</div>
      <dl class="kv">
        <dt>账号</dt><dd><%= user.email %></dd>
        <dt>角色</dt><dd><span class="tag tag--info"><%= user.role %></span></dd>
        <dt>登录时间</dt><dd><%= user.lastLoginAt || '—' %></dd>
        <dt>会话开始</dt><dd><%= user.sessionCreatedAt %></dd>
        <dt>会话有效期</dt><dd><%= user.expiresAt %></dd>
        <dt>来源 IP</dt><dd><%= user.ip || '—' %></dd>
        <dt>客户端</dt><dd class="muted" style="font-size:.85rem"><%= user.userAgent || '—' %></dd>
      </dl>
    </div>

    <div class="panel">
      <div class="footer__title">存储加密状态</div>
      <dl class="kv">
        <dt>算法</dt><dd>AES-256-GCM（认证加密）</dd>
        <dt>密钥派生</dt><dd>HKDF-SHA256，每份数据独立盐与 nonce</dd>
        <dt>当前生效密钥</dt><dd class="mono"><%= activeKeyId %></dd>
        <dt>资源条目</dt><dd><%= storage.n %> 个（<%= (storage.bytes / 1024).toFixed(0) %> KB 明文）</dd>
        <dt>完整性</dt><dd>GCM 认证标签 + 明文 SHA-256 双重校验</dd>
      </dl>
      <p class="muted" style="font-size:.85rem;margin:.8rem 0 0">
        解密失败不会返回可疑内容：资源会退回占位图，并在审计流水里留一条记录。
      </p>
    </div>
  </div>
</section>

<section class="section--tight">
  <div class="container">
    <span class="eyebrow">// tickets</span>
    <h2>服务工单</h2>
    <div class="panel" style="margin-top:1rem;overflow-x:auto">
      <% if (!tickets.length) { %>
      <p class="muted" style="margin:0">暂无工单。提交需求后，进度会同步到这里。</p>
      <% } else { %>
      <table class="table">
        <thead>
          <tr><th>编号</th><th>事项</th><th>负责人</th><th>状态</th><th>最近更新</th><th>备注</th></tr>
        </thead>
        <tbody>
          <% tickets.forEach(function (t) { %>
          <tr>
            <td class="mono"><%= t.code %></td>
            <td><%= t.subject %></td>
            <td><%= t.owner %></td>
            <td>
              <span class="tag <%= t.status === 'done' ? 'tag--ok' : (t.status === 'doing' ? 'tag--info' : 'tag--warn') %>">
                <%= t.status === 'done' ? '已完成' : (t.status === 'doing' ? '进行中' : '待排期') %>
              </span>
            </td>
            <td class="mono" style="font-size:.85rem"><%= t.updated %></td>
            <td class="muted" style="font-size:.88rem"><%= t.note || '' %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    <span class="eyebrow">// files</span>
    <h2>交付文件</h2>
    <p class="muted" style="font-size:.92rem">
      文件字节全部来自数据库解密，服务端没有任何对应的公开文件；下载链接需要保持登录状态。
    </p>
    <div class="grid grid--3" style="margin-top:1.2rem">
      <% files.forEach(function (f) { %>
      <article class="card">
        <h3 style="font-size:1rem;margin-bottom:.4rem"><%= f.title %></h3>
        <p class="muted" style="font-size:.88rem"><%= f.note %></p>
        <dl class="kv" style="font-size:.85rem;margin:.6rem 0">
          <dt>类型</dt><dd class="mono"><%= f.mime %></dd>
          <dt>大小</dt><dd class="mono"><%= (f.byteSize / 1024).toFixed(1) %> KB</dd>
        </dl>
        <a class="btn btn--sm" href="/member/files/<%= encodeURIComponent(f.assetKey) %>">下载</a>
      </article>
      <% }); %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
