<%- include('partials/head') %>

<section class="section" style="padding-top:2.8rem">
  <div class="container">
    <div class="row" style="justify-content:space-between;align-items:flex-end">
      <div>
        <span class="eyebrow">// admin console</span>
        <h1 style="font-size:2rem;margin-bottom:.3rem">管理台</h1>
        <p class="muted" style="margin:0">留言在此解密查看；所有解密失败都会留下审计记录。</p>
      </div>
      <form method="post" action="/logout" style="margin:0">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="btn btn--sm btn--ghost" type="submit">安全登出</button>
      </form>
    </div>
  </div>
</section>

<section class="section--tight" id="messages">
  <div class="container">
    <span class="eyebrow">// contact messages</span>
    <h2>联系留言</h2>
    <div class="stack" style="margin-top:1.2rem">
      <% if (!messages.length) { %>
      <div class="panel"><p class="muted" style="margin:0">还没有留言。</p></div>
      <% } %>
      <% messages.forEach(function (m) { %>
      <article class="card" style="padding:1.3rem">
        <% if (m.error) { %>
        <div class="notice notice--error" style="margin:0">
          <span>▍</span>
          <span>该条留言解密失败（<%= m.error.code %>）：<%= m.error.message %>。已记录审计日志。</span>
        </div>
        <% } else { %>
        <div class="row" style="justify-content:space-between;gap:1rem">
          <div>
            <h3 style="margin:0"><%= m.data.name %> · <%= m.data.topic %></h3>
            <p class="mono" style="font-size:.84rem;color:var(--dim);margin:.2rem 0 0">
              <%= m.data.email %> · <%= m.data.submittedAt %> · IP <%= m.data.ip || '—' %>
            </p>
          </div>
          <span class="tag <%= m._meta.status === 'closed' ? 'tag--ok' : (m._meta.status === 'reading' ? 'tag--info' : 'tag--warn') %>">
            <%= m._meta.status %>
          </span>
        </div>
        <p style="margin:.9rem 0;white-space:pre-wrap"><%= m.data.body %></p>
        <div class="row" style="gap:.6rem">
          <% if (m.data.attachmentKey) { %>
          <a class="btn btn--sm" href="/admin/messages/<%= m._meta.id %>/attachment">下载附件<%= m.data.attachmentName ? '（' + m.data.attachmentName + '）' : '' %></a>
          <% } %>
          <form method="post" action="/admin/messages/<%= m._meta.id %>/status" style="margin:0" class="row">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="status" value="reading">
            <button class="btn btn--sm btn--ghost" type="submit">标记处理中</button>
          </form>
          <form method="post" action="/admin/messages/<%= m._meta.id %>/status" style="margin:0" class="row">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="status" value="closed">
            <button class="btn btn--sm" type="submit">标记已关闭</button>
          </form>
        </div>
        <% } %>
      </article>
      <% }); %>
    </div>
  </div>
</section>

<section class="section--tight">
  <div class="container grid grid--2" style="align-items:start">
    <div>
      <span class="eyebrow">// users</span>
      <h2>账号</h2>
      <div class="panel" style="margin-top:1rem;overflow-x:auto">
        <table class="table">
          <thead><tr><th>ID</th><th>昵称</th><th>角色</th><th>状态</th><th>最近登录</th></tr></thead>
          <tbody>
            <% users.forEach(function (u) { %>
            <tr>
              <td class="mono"><%= u.id %></td>
              <td><%= u.display_name %></td>
              <td><span class="tag <%= u.role === 'admin' ? 'tag--info' : '' %>"><%= u.role %></span></td>
              <td><%= u.status %></td>
              <td class="mono" style="font-size:.85rem"><%= u.last_login_at || '—' %></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>

    <div>
      <span class="eyebrow">// crypto & storage</span>
      <h2>密钥与存储</h2>
      <div class="panel" style="margin-top:1rem">
        <div class="footer__title">密钥环</div>
        <table class="table">
          <thead><tr><th>Key ID</th><th>来源</th><th>状态</th><th>创建时间</th></tr></thead>
          <tbody>
            <% keys.forEach(function (k) { %>
            <tr>
              <td class="mono" style="font-size:.82rem"><%= k.key_id %></td>
              <td><%= k.source %></td>
              <td><%= Number(k.is_active) === 1 ? '<span class="tag tag--ok">active</span>' : '<span class="tag">inactive</span>' %></td>
              <td class="mono" style="font-size:.82rem"><%= k.created_at %></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
        <div class="footer__title" style="margin-top:1.2rem">加密文档分布</div>
        <% if (!docStats.length) { %>
        <p class="muted" style="font-size:.9rem;margin:0">暂无数据。</p>
        <% } %>
        <ul class="checklist" style="font-size:.9rem">
          <% docStats.forEach(function (d) { %><li><%= d.kind %>：<%= d.n %> 条</li><% }); %>
        </ul>
        <p class="muted" style="font-size:.86rem;margin:.6rem 0 0">
          资源共 <%= storage.n %> 项 / <%= (storage.bytes / 1024).toFixed(0) %> KB（明文计）。轮换密钥用
          <span class="mono">npm run rotate-key</span>。
        </p>
      </div>
    </div>
  </div>
</section>

<section class="section--tight">
  <div class="container">
    <span class="eyebrow">// audit trail</span>
    <h2>审计流水</h2>
    <div class="panel" style="margin-top:1rem;overflow-x:auto">
      <table class="table">
        <thead><tr><th>时间</th><th>主体</th><th>动作</th><th>对象</th><th>结果</th></tr></thead>
        <tbody>
          <% audit.forEach(function (a) { %>
          <tr>
            <td class="mono" style="font-size:.82rem"><%= a.at %></td>
            <td class="mono" style="font-size:.82rem"><%= a.actor || '—' %></td>
            <td class="mono" style="font-size:.82rem"><%= a.action %></td>
            <td class="mono" style="font-size:.82rem"><%= a.target || '—' %></td>
            <td><%= Number(a.ok) === 1 ? '<span class="tag tag--ok">ok</span>' : '<span class="tag tag--warn">fail</span>' %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
