{
  "name": "allin",
  "version": "0.1.0",
  "private": true,
  "description": "工作区治理仓（公开，MIT）：文档枢纽 + 可执行门禁 + cordis 治理 preset（粘合剂）",
  "license": "MIT-0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check": "npm run check:governance && npm run check:docs && npm run check:ps1 && npm run check:preset-sync && npm run check:routes",
    "check:governance": "node scripts/gates.mjs --no-profile",
    "check:governance:selfcheck": "node scripts/gates.mjs --selfcheck-all",
    "check:precommit": "bash scripts/run_all_gates.sh",
    "check:docs": "node scripts/run_py.mjs tools/gate/docs_index.py",
    "check:ps1": "node scripts/run_py.mjs tools/gate/check_ps1_bom.py --root .",
    "check:agent": "node scripts/run_py.mjs tools/gate/agent_regression.py",
    "check:routes": "node scripts/run_py.mjs tools/gate/agent_parity.py",
    "check:preset-sync": "node scripts/run_py.mjs preset/allin/refresh-gov-block.py --check",
    "verify:projects": "node scripts/run_py.mjs tools/verify_projects.py --workers 8",
    "metrics:gates": "node scripts/run_py.mjs tools/gate/gate_metrics.py --snapshot",
    "sbom": "node scripts/run_py.mjs tools/sbom.py",
    "licenses": "node scripts/run_py.mjs tools/license_matrix.py",
    "sarif": "node scripts/run_py.mjs tools/sarif.py",
    "smoke:e2e": "node scripts/smoke_e2e.mjs",
    "console:check": "npm --prefix console run check",
    "console:smoke": "npm --prefix console run smoke",
    "console:plugins": "npm --prefix console run verify:plugins",
    "console:lifecycle": "npm --prefix console run verify:lifecycle",
    "check:guide": "python tools/tutorial/verify_guide.py"
  }
}
