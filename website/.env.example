# allin 官网配置样例
# 复制本文件为 .env 后按需修改；.env 已被 .gitignore 忽略，禁止提交。

# 监听端口
PORT=9042

# 站点地址（用于拼接回调/跳转，生产改为真实域名）
SITE_BASE_URL=http://localhost:9042

# 会话 Cookie 名
SESSION_COOKIE_NAME=allin_sid

# 会话有效期（小时）
SESSION_TTL_HOURS=72

# ⚠️ 生产必配：走 HTTPS 反向代理后改为 true，否则会话 Cookie 以明文传输
# （secure 默认 false 仅适合本地 HTTP 开发）
COOKIE_SECURE=false

# 数据库文件
DB_PATH=./data/site.db

# 主密钥目录
KEY_DIR=./data/keys

# 主密钥（base64 编码的 32 字节随机串）；留空则由 init 生成磁盘密钥文件。
# 生产建议从密钥管理服务注入环境变量，不要依赖磁盘密钥文件。
SITE_MASTER_KEY_BASE64=

# 附件上限（MB）
MAX_UPLOAD_MB=5
